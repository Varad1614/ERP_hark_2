# Part 2 · S5-capacity: TLS edge of the capacity stack (deploy/capacity/compose.yml), the role a
# college's reverse proxy / load balancer plays. Host network: $remote_addr is the real client
# address. The edge is the outermost trusted proxy, so it REPLACES any client-supplied
# X-Forwarded-For with the address it saw (never trusts the client's header); the web nginx then
# appends its own hop → the API counts 2 trusted hops (SUTRA_TRUSTED_PROXY_HOPS=2).
ssl_certificate     /etc/nginx/tls/edge.crt;
ssl_certificate_key /etc/nginx/tls/edge.key;
ssl_protocols TLSv1.2 TLSv1.3;
ssl_session_cache shared:SSL:20m;
ssl_session_timeout 1h;
# keepalive_timeout is set per server: the stock nginx.conf already sets it in http {}.
keepalive_requests 10000;
access_log /var/log/nginx/access.log combined buffer=64k flush=5s;

upstream sutra_web  { server 127.0.0.1:3000; keepalive 64; }
upstream sutra_sso  { server 127.0.0.1:8180; keepalive 32; }
upstream sutra_s3   { server 127.0.0.1:9000; keepalive 32; }

server {
  listen 443 ssl;
  http2 on;
  keepalive_timeout 75s;
  server_name erp.${CAP_DOMAIN};
  client_max_body_size 12m;
  location / {
    proxy_pass http://sutra_web;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
  }
}

server {
  listen 443 ssl;
  http2 on;
  keepalive_timeout 75s;
  server_name sso.${CAP_DOMAIN};
  location / {
    proxy_pass http://sutra_sso;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Port 443;
    proxy_buffer_size 64k;
    proxy_buffers 8 64k;
  }
}

server {
  listen 443 ssl;
  http2 on;
  keepalive_timeout 75s;
  server_name s3.${CAP_DOMAIN};
  client_max_body_size 20m;
  location / {
    proxy_pass http://sutra_s3;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    # SigV4 signs the Host header: pass it unchanged.
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_request_buffering off;
    proxy_buffering off;
  }
}
