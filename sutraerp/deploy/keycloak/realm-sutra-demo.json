{
  "realm": "sutra-demo",
  "enabled": true,
  "displayName": "SutraERP demo",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "quickLoginCheckMilliSeconds": 1000,
  "minimumQuickLoginWaitSeconds": 60,
  "otpPolicyCodeReusable": false,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "administrator"
      },
      {
        "name": "faculty"
      },
      {
        "name": "student"
      },
      {
        "name": "finance_approver",
        "description": "Checker: finance decisions (refunds, adjustments, write-offs, fee structures)"
      },
      {
        "name": "exam_controller",
        "description": "Checker: controller of examinations (exam setup, marks, results, publication)"
      },
      {
        "name": "registrar",
        "description": "Checker: admission decisions"
      },
      {
        "name": "payroll_approver",
        "description": "Checker: payroll runs, adjustments, final settlements"
      },
      {
        "name": "procurement_approver",
        "description": "Checker: requisitions, purchase orders, vendor invoices"
      }
    ]
  },
  "clients": [
    {
      "clientId": "sutra-web",
      "name": "SutraERP web (BFF)",
      "description": "Confidential OIDC client of the public demo (sutra-api BFF, Authorization Code + PKCE S256). No ROPC. Secret, URLs and user passwords come from the environment at import (docker-compose.oidc-demo.yml).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${SUTRA_DEMO_OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "${SUTRA_DEMO_PUBLIC_URL}/api/v1/auth/oidc/callback"
      ],
      "webOrigins": [
        "${SUTRA_DEMO_PUBLIC_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${SUTRA_DEMO_PUBLIC_URL}/sign-in",
        "backchannel.logout.url": "http://api:8080/api/v1/auth/oidc/backchannel-logout",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false",
        "use.refresh.tokens": "false",
        "acr.loa.map": "{\"pwd\":\"1\",\"mfa\":\"2\"}",
        "minimum.acr.value": "1",
        "id.token.signed.response.alg": "RS256"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "basic",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "offline_access"
      ],
      "protocolMappers": [
        {
          "name": "realm roles in ID token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "tenant_id (user attribute)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "institution_id (user attribute)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "institution_id",
            "claim.name": "institution_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin@sutra.dev",
      "email": "admin@sutra.dev",
      "firstName": "Dhruv",
      "lastName": "Naik",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": [
        "administrator"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${SUTRA_DEMO_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "requiredActions": [
        "CONFIGURE_TOTP"
      ],
      "groups": [
        "/sutra-tenant-0192f5a0-7c3e-7000-8000-000000000001"
      ],
      "id": "5e7a0c1e-0000-4000-8000-00000000ad01"
    },
    {
      "username": "meera.shah@sutra.dev",
      "email": "meera.shah@sutra.dev",
      "firstName": "Meera",
      "lastName": "Shah",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": [
        "faculty"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${SUTRA_DEMO_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "groups": [
        "/sutra-tenant-0192f5a0-7c3e-7000-8000-000000000001"
      ],
      "id": "5e7a0c1e-0000-4000-8000-00000000fa01"
    },
    {
      "username": "aarav.desai@sutra.dev",
      "email": "aarav.desai@sutra.dev",
      "firstName": "Aarav",
      "lastName": "Desai",
      "enabled": true,
      "emailVerified": true,
      "realmRoles": [
        "student"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${SUTRA_DEMO_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "groups": [
        "/sutra-tenant-0192f5a0-7c3e-7000-8000-000000000001"
      ],
      "id": "5e7a0c1e-0000-4000-8000-000000005701"
    }
  ],
  "sslRequired": "${SUTRA_DEMO_KC_SSL_REQUIRED:external}",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "webAuthnPolicyRpEntityName": "SutraERP",
  "webAuthnPolicyUserVerificationRequirement": "preferred",
  "attributes": {
    "acr.loa.map": "{\"pwd\":\"1\",\"mfa\":\"2\"}"
  },
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": false,
      "priority": 10,
      "config": {}
    },
    {
      "alias": "webauthn-register",
      "name": "Webauthn Register",
      "providerId": "webauthn-register",
      "enabled": true,
      "defaultAction": false,
      "priority": 20,
      "config": {}
    },
    {
      "alias": "webauthn-register-passwordless",
      "name": "Webauthn Register Passwordless",
      "providerId": "webauthn-register-passwordless",
      "enabled": true,
      "defaultAction": false,
      "priority": 30,
      "config": {}
    },
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 40,
      "config": {}
    },
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": false,
      "priority": 50,
      "config": {}
    }
  ],
  "browserFlow": "browser-sutra",
  "authenticationFlows": [
    {
      "alias": "browser-sutra",
      "description": "Built-in browser steps (cookie, password, conditional OTP) with AMR references pwd/otp, so the ID token amr shows MFA to SutraERP",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "flowAlias": "browser-sutra forms",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "browser-sutra forms",
      "description": "Username + password, then the conditional OTP.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "authenticatorConfig": "amr-pwd",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "CONDITIONAL",
          "priority": 20,
          "flowAlias": "browser-sutra conditional otp",
          "userSetupAllowed": false
        }
      ]
    },
    {
      "alias": "browser-sutra conditional otp",
      "description": "OTP form when the user has an OTP credential.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "conditional-user-configured",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "auth-otp-form",
          "authenticatorConfig": "amr-otp",
          "authenticatorFlow": false,
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "authenticatorConfig": [
    {
      "alias": "amr-pwd",
      "config": {
        "default.reference.value": "pwd",
        "default.reference.maxAge": "0"
      }
    },
    {
      "alias": "amr-otp",
      "config": {
        "default.reference.value": "otp",
        "default.reference.maxAge": "0"
      }
    }
  ],
  "groups": [
    {
      "name": "sutra-tenant-0192f5a0-7c3e-7000-8000-000000000001",
      "path": "/sutra-tenant-0192f5a0-7c3e-7000-8000-000000000001",
      "attributes": {
        "tenant_id": [
          "0192f5a0-7c3e-7000-8000-000000000001"
        ]
      },
      "subGroups": []
    }
  ]
}
