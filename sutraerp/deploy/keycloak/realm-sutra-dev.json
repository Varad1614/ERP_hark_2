{
  "realm": "sutra",
  "enabled": true,
  "displayName": "SutraERP (dev)",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {
        "name": "administrator"
      },
      {
        "name": "faculty"
      },
      {
        "name": "student"
      },
      {
        "name": "finance_approver",
        "description": "Checker: finance decisions (refunds, adjustments, write-offs, fee structures)"
      },
      {
        "name": "exam_controller",
        "description": "Checker: controller of examinations (exam setup, marks, results, publication)"
      },
      {
        "name": "registrar",
        "description": "Checker: admission decisions"
      },
      {
        "name": "payroll_approver",
        "description": "Checker: payroll runs, adjustments, final settlements"
      },
      {
        "name": "procurement_approver",
        "description": "Checker: requisitions, purchase orders, vendor invoices"
      }
    ]
  },
  "clients": [
    {
      "clientId": "sutra-api",
      "enabled": true,
      "publicClient": false,
      "secret": "dev-only-change-me",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "description": "Service-account client for future machine-to-machine calls (no browser flows)."
    },
    {
      "clientId": "sutra-web",
      "name": "SutraERP web (BFF)",
      "description": "Confidential OIDC client used by sutra-api as backend-for-frontend (Authorization Code + PKCE S256). No ROPC.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-only-change-me",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "redirectUris": [
        "http://localhost:5173/api/v1/auth/oidc/callback",
        "http://localhost:3000/api/v1/auth/oidc/callback"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:5173/sign-in##http://localhost:3000/sign-in",
        "backchannel.logout.url": "http://api:8080/api/v1/auth/oidc/backchannel-logout",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false",
        "use.refresh.tokens": "false",
        "acr.loa.map": "{\"pwd\":\"1\",\"mfa\":\"2\"}",
        "minimum.acr.value": "1",
        "id.token.signed.response.alg": "RS256"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "basic",
        "profile",
        "email"
      ],
      "optionalClientScopes": [
        "offline_access"
      ],
      "protocolMappers": [
        {
          "name": "realm roles in ID token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "tenant_id (dev: hardcoded)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "tenant_id",
            "claim.value": "0192f5a0-7c3e-7000-8000-000000000001",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "institution_id (dev: hardcoded)",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "institution_id",
            "claim.value": "0192f5a0-7c3e-7000-8000-0000000000aa",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "amr",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-amr-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
