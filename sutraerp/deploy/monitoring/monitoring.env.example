# SutraERP monitoring settings (Part 2 S5-monitor). Copy to /etc/sutraerp/monitoring.env, chmod 600,
# fill in, then: python3 alertmanager/render.py --env /etc/sutraerp/monitoring.env --out alertmanager/alertmanager.yml
# and docker compose --env-file /etc/sutraerp/monitoring.env -f compose.yaml up -d --wait
#
# ---- Grafana
SUTRA_GRAFANA_ADMIN_USER=admin
SUTRA_GRAFANA_ADMIN_PASSWORD=change-me-to-a-long-random-password
SUTRA_GRAFANA_ROOT_URL=https://erp-monitor.college.example/
# ---- scrape targets
# postgres_exporter → PostgreSQL (role from postgres/monitor-role.sql; sslmode=verify-full off-host)
SUTRA_MON_PG_DSN=postgresql://sutra_monitor:change-me@host.docker.internal:5432/sutra?sslmode=disable
# NATS monitoring endpoint (nats-server -m 8222)
SUTRA_MON_NATS_MONITOR_URL=http://host.docker.internal:8222
# Directory the backup wrapper (textfile/sutra-backup-metrics.sh) writes *.prom files to
SUTRA_MON_TEXTFILE_DIR=/var/lib/sutraerp/node-exporter
SUTRA_MON_RETENTION=30d
# ---- alert delivery — BLOCKED_EXTERNAL until the college provides these (templates until then)
# E-mail through the college SMTP relay
SUTRA_AM_SMTP_SMARTHOST=smtp.college.example:587
SUTRA_AM_SMTP_FROM=sutraerp-alerts@college.example
SUTRA_AM_SMTP_USERNAME=
SUTRA_AM_SMTP_PASSWORD=
SUTRA_AM_SMTP_REQUIRE_TLS=true
SUTRA_AM_EMAIL_TO=erp-ops@college.example
# Chat: webhook | slack | msteamsv2 | discord
SUTRA_AM_CHAT_KIND=webhook
SUTRA_AM_CHAT_URL=
# SMS gateway adapter (receives Alertmanager webhook JSON; critical alerts only)
SUTRA_AM_SMS_WEBHOOK_URL=
# Dead-man's switch (e.g. a healthchecks.io-style ping URL) for the always-firing SutraWatchdog
SUTRA_AM_DEADMAN_URL=
