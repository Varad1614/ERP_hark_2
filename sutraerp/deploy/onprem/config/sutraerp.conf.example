# /etc/sutraerp/sutraerp.conf — SutraERP on-prem server settings (bash syntax; no secrets here:
# secrets.env is generated by `sutra-onprem secrets`). After editing: sutra-onprem render && sutra-onprem start
#
# Host names users type (both must resolve to this server: college DNS A records, or /etc/hosts on
# every client for a pilot). The TLS certificate must cover both (subjectAltName).
SUTRA_DOMAIN=erp.college.example.edu.in
SUTRA_SSO_DOMAIN=sso.college.example.edu.in
SUTRA_INSTITUTION_NAME=SutraERP
# Published ports of the TLS edge (80 only redirects to https).
SUTRA_HTTP_PORT=80
SUTRA_HTTPS_PORT=443
# TLS (install --cert/--key/--ca or tls-local-ca fill these): full chain, private key, and the CA
# that issued it when it is a college / private CA (trusted by the API for the SSO back channel).
#SUTRA_TLS_CERT_FILE=/etc/sutraerp/tls/college/fullchain.pem
#SUTRA_TLS_KEY_FILE=/etc/sutraerp/tls/college/privkey.pem
#SUTRA_TLS_CA_FILE=/etc/sutraerp/tls/college/ca.pem
# Outgoing e-mail (notifications). Empty SUTRA_SMTP_HOST = e-mail off. Production refuses plain SMTP.
SUTRA_SMTP_HOST=
SUTRA_SMTP_PORT=587
SUTRA_SMTP_TLS=starttls
SUTRA_SMTP_USER=
SUTRA_SMTP_PASSWORD=
SUTRA_MAIL_FROM=
# Backups (sutra-onprem backup; schedule it with the systemd timer in the runbook).
SUTRA_BACKUP_DIR=/var/backups/sutraerp
# Document storage bucket (created private by install).
SUTRA_S3_BUCKET=sutraerp-documents
# Tuning (see INFRASTRUCTURE_REPORT.md for the measured footprint): PostgreSQL shared_buffers
# ≈ 25 % of the RAM you give the database; JVM heaps of Keycloak / Flowable; Valkey cache cap.
SUTRA_PG_SHARED_BUFFERS=512MB
SUTRA_PG_MAX_CONNECTIONS=200
SUTRA_KC_HEAP=768m
SUTRA_FLOWABLE_HEAP=768m
SUTRA_VALKEY_MAXMEMORY=256mb
