# /etc/sutraerp/backup.env — configuration of the SutraERP backup scripts on a single-server
# (docker compose) installation. Owner root, mode 0600. Part 2 · Stage 5; runbook
# docs/runbooks/backup-dr.md § "Single-server (docker compose) installation".
#
# Where backup sets are written (a disk / partition that is NOT the docker data disk).
SUTRA_BACKUP_DIR=/var/backups/sutraerp
# Label recorded in backup manifests. backup.env never overrides a variable the caller set, so it
# does not leak into `sutra-api migrate` during a logical restore.
SUTRA_ENV=production
# Logical restore on a docker compose host (no sutra-api binary): verify without migrating here;
# `docker compose up` runs the migrate service afterwards.
#SUTRA_RESTORE_SKIP_MIGRATE=true
# Database: the `sutra` database as the schema owner / a superuser (counts must bypass RLS).
SUTRA_BACKUP_DATABASE_URL=postgres://sutra:CHANGE_ME@127.0.0.1:5432/sutra
# Optional Flowable database (same server).
#SUTRA_BACKUP_FLOWABLE_DATABASE_URL=postgres://sutra:CHANGE_ME@127.0.0.1:5432/flowable
# Keycloak database (users, credentials, realm configuration).
SUTRA_BACKUP_KEYCLOAK_DATABASE_URL=postgres://sutra:CHANGE_ME@127.0.0.1:5432/keycloak
# Optional realm export for configuration review (admin REST partial-export).
#SUTRA_KC_URL=http://127.0.0.1:8180
#SUTRA_KC_ADMIN_USER=backup-reader
#SUTRA_KC_ADMIN_PASSWORD=CHANGE_ME
# Document storage (a read-only key is enough for backups; restore needs write).
SUTRA_S3_ENDPOINT=http://127.0.0.1:9000
SUTRA_S3_BUCKET=sutraerp-documents
SUTRA_S3_ACCESS_KEY_ID=CHANGE_ME
SUTRA_S3_SECRET_ACCESS_KEY=CHANGE_ME
# Base backups (pg_basebackup runs inside the postgres container over its local socket).
SUTRA_PG_CONTAINER=sutraerp-postgres-1
SUTRA_PG_STAGING_DIR=/var/backups/sutraerp/staging
SUTRA_PG_STAGING_IN_CONTAINER=/backup-staging
# WAL archive: written by PostgreSQL (archive_command), shipped encrypted by sutra-wal-ship.sh.
SUTRA_WAL_ARCHIVE_DIR=/var/lib/sutraerp/wal-archive
SUTRA_WAL_OFFSITE_DIR=/mnt/offsite/sutraerp/wal
# Encryption: age PUBLIC key(s) only. The matching identity (private key) is NOT on this server:
# keep it printed in the college safe + in a second administrator's password manager.
SUTRA_BACKUP_AGE_RECIPIENT=age1CHANGE_ME
#SUTRA_BACKUP_AGE_RECIPIENTS_FILE=/etc/sutraerp/backup-recipients.txt
# Rotation (rotate.sh): days / ISO weeks / months of nightly sets, base backups kept.
SUTRA_KEEP_DAILY=14
SUTRA_KEEP_WEEKLY=8
SUTRA_KEEP_MONTHLY=12
SUTRA_KEEP_BASE=2
# Offsite copy (offsite.sh): second disk / other machine over SSH / S3-compatible store elsewhere.
SUTRA_OFFSITE_TARGET=/mnt/offsite/sutraerp
#SUTRA_OFFSITE_TARGET=backup@dr-host.college.example:/srv/sutraerp
#SUTRA_OFFSITE_TARGET=s3://college-dr-backups/sutraerp
#SUTRA_OFFSITE_S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
#SUTRA_OFFSITE_ACCESS_KEY_ID=CHANGE_ME
#SUTRA_OFFSITE_SECRET_ACCESS_KEY=CHANGE_ME
# Inventory: the installation directory and env file (names recorded, never values).
SUTRA_COMPOSE_DIR=/opt/sutraerp
SUTRA_ENV_FILE=/opt/sutraerp/.env
