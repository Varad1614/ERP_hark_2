{
  "name": "sutraerp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "gen:api": "pnpm --filter @sutra/api-client generate",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "dev": "pnpm --filter @sutra/web dev",
    "e2e:passkey": "pnpm --filter @sutra/web e2e:passkey",
    "e2e:student": "pnpm --filter @sutra/web e2e:student",
    "e2e:academic": "pnpm --filter @sutra/web e2e:academic",
    "e2e:finance": "pnpm --filter @sutra/web e2e:finance",
    "e2e:ui": "pnpm --filter @sutra/web e2e:ui",
    "e2e:exams": "pnpm --filter @sutra/web e2e:exams",
    "e2e:people": "pnpm --filter @sutra/web e2e:people",
    "e2e:campus": "pnpm --filter @sutra/web e2e:campus",
    "e2e:reskin2": "pnpm --filter @sutra/web e2e:reskin2",
    "e2e:imports": "pnpm --filter @sutra/web e2e:imports",
    "e2e:uat-dryrun": "pnpm --filter @sutra/web e2e:uat-dryrun"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1"
  }
}
