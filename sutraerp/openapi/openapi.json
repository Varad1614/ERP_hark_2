{
  "openapi": "3.1.0",
  "info": {
    "title": "SutraERP API",
    "description": "SutraERP education ERP — synchronous REST/JSON API (major version v1).\n\nConventions (ADR-L5-0034): camelCase JSON members; URL major versioning (`/api/v1`); RFC 9457 `application/problem+json` errors with `errorCode`, `correlationId` and `validationErrors` extensions; retry-sensitive commands accept `Idempotency-Key`.\n\nAuthentication (ADR-L5-0024/0038): dev mode signs in with `POST /api/v1/auth/login` (+ TOTP `POST /api/v1/auth/mfa/verify`); Keycloak mode with the OIDC Authorization Code + PKCE flow `GET /api/v1/auth/oidc/start` → `/oidc/callback`. Both set an opaque `HttpOnly` session cookie; the session's `csrfToken` must be sent as `X-CSRF-Token` on every POST/PUT/PATCH/DELETE made with the cookie. Login and MFA verification instead need the signed double-submit token from `GET /api/v1/auth/csrf`. Unsafe requests from another site (`Origin` / `Sec-Fetch-Site`) are rejected. Tenant/institution scope is taken from the session (ADR-L5-0004); scope headers cannot select or widen it. Admin-sensitive permissions need an MFA-verified session (`mfa-step-up-required`). Missing session: 401; CSRF failure, cross-site request, missing permission or step-up: 403 (`application/problem+json`).",
    "license": {
      "name": "UNLICENSED",
      "identifier": "UNLICENSED"
    },
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/auth/csrf": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Issue a pre-session (login) CSRF token.",
        "description": "Sets the `__Host-sutra_login_csrf` cookie and returns the same signed value; `POST /login`\nand `POST /mfa/verify` must echo it in `X-CSRF-Token` (signed double submit).",
        "operationId": "csrf",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CsrfTokenResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Authenticate with login id + password (dev mode).",
        "description": "Requires the pre-session CSRF token (`GET /api/v1/auth/csrf`) in `X-CSRF-Token`. On success\nsets an opaque `HttpOnly; Secure; SameSite=Strict` session cookie and returns the session's\nCSRF token. Principals that need MFA and have an enrolled TOTP factor get `mfaRequired` and\nmust call `/api/v1/auth/mfa/verify`; those without a factor get a single-factor session with\n`mfaEnrollmentRequired = true`. Any presented session is revoked and replaced (fixation\ndefence). In Keycloak mode this endpoint answers `501` (no ROPC; use OIDC).",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Authenticated or MFA required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials (generic)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Login CSRF token missing/invalid or cross-site request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "501": {
            "description": "Password login not offered (Keycloak mode)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "login_csrf": []
          }
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "End the current session (idempotent).",
        "description": "With a live session the request must carry `X-CSRF-Token` (prevents forced sign-out). For a\nKeycloak session the response is `200` with the IdP's RP-initiated logout URL.",
        "operationId": "logout",
        "responses": {
          "200": {
            "description": "Signed out; continue at the IdP to end the SSO session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogoutResponse"
                }
              }
            }
          },
          "204": {
            "description": "Signed out"
          },
          "403": {
            "description": "CSRF token missing or invalid",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "csrf_token": [],
            "session_cookie": []
          }
        ]
      }
    },
    "/api/v1/auth/mfa/step-up": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Step up the current session with a TOTP code (needed for admin-sensitive permissions).",
        "description": "The session is rotated (new cookie and CSRF token) to `mfaLevel = mfa`; its absolute expiry\nis unchanged. In Keycloak mode use `GET /api/v1/auth/oidc/start?stepUp=true` instead.",
        "operationId": "step_up",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TotpCodeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "No session, wrong or replayed code",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "501": {
            "description": "MFA is managed by Keycloak",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "csrf_token": [],
            "session_cookie": []
          }
        ]
      }
    },
    "/api/v1/auth/mfa/totp/confirm": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Confirm TOTP enrolment with the first code; activates the factor and upgrades the session.",
        "description": "The session is rotated (new cookie and CSRF token) to `mfaLevel = mfa`.",
        "operationId": "totp_confirm",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TotpCodeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "No enrolment in progress",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Wrong code",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "csrf_token": [],
            "session_cookie": []
          }
        ]
      }
    },
    "/api/v1/auth/mfa/totp/enrolment": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Start TOTP enrolment for the signed-in account (dev mode).",
        "description": "Returns a fresh secret as an `otpauth://` URI; nothing changes until `…/totp/confirm`\naccepts a code from it. Replacing an already active factor requires an MFA-verified session.",
        "operationId": "totp_enrolment",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TotpEnrolmentResponse"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Replacing a factor needs step-up",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "501": {
            "description": "MFA is managed by Keycloak",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "csrf_token": [],
            "session_cookie": []
          }
        ]
      }
    },
    "/api/v1/auth/mfa/verify": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Complete a TOTP challenge issued by `login`.",
        "description": "Requires the same pre-session CSRF token the challenge was issued to. A challenge is single\nuse (a wrong code burns it) and expires after 5 minutes; each TOTP time step is accepted once.",
        "operationId": "verify_mfa",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MfaVerifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unknown/expired challenge, wrong or replayed code",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Login CSRF token missing/invalid",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "login_csrf": []
          }
        ]
      }
    },
    "/api/v1/auth/mfa/webauthn/assertion": {
      "post": {
        "tags": [
