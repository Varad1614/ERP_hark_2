        "summary": "Begin a WebAuthn assertion (step-up) — **deferred** (`501`).",
        "operationId": "webauthn_assertion",
        "responses": {
          "501": {
            "description": "Deferred: WebAuthn is offered through Keycloak",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "csrf_token": [],
            "session_cookie": []
          }
        ]
      }
    },
    "/api/v1/auth/mfa/webauthn/registration": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Begin WebAuthn credential registration — **deferred** (`501`).",
        "operationId": "webauthn_registration",
        "responses": {
          "501": {
            "description": "Deferred: WebAuthn is offered through Keycloak",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "csrf_token": [],
            "session_cookie": []
          }
        ]
      }
    },
    "/api/v1/auth/oidc/callback": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "OIDC redirect endpoint (Keycloak → SutraERP).",
        "description": "Consumes the single-use `state`, checks the browser-binding cookie, exchanges the code with\nthe PKCE verifier, validates the ID token (JWKS signature, `iss`, `aud`, `exp`, `nonce`),\nmaps roles and tenant claims, creates the session and redirects (`303`) into the SPA. Any\nfailure redirects to `/sign-in?authError=<code>` without a session.",
        "operationId": "oidc_callback",
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "error",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Session created → SPA, or failure → /sign-in?authError=…"
          }
        }
      }
    },
    "/api/v1/auth/oidc/start": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Start an OIDC sign-in at Keycloak (Authorization Code + PKCE, Keycloak mode).",
        "description": "Stores `state`, `nonce` and the PKCE verifier server-side for 10 minutes, binds the request\nto this browser with a `SameSite=Lax` cookie and redirects (`303`) to Keycloak.",
        "operationId": "oidc_start",
        "parameters": [
          {
            "name": "returnTo",
            "in": "query",
            "description": "SPA path to land on after sign-in (relative, same origin). Defaults to `/`.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "stepUp",
            "in": "query",
            "description": "Request a fresh multi-factor authentication (step-up).",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "Redirect to the Keycloak authorization endpoint"
          },
          "501": {
            "description": "OIDC not configured (dev mode)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Identity provider unreachable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
