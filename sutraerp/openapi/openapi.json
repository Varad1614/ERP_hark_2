            }
          },
          {
            "name": "group",
            "in": "query",
            "description": "Navigation group filter (e.g. `students`, `finance`).",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceList"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/platform/workspaces/{key}": {
      "get": {
        "tags": [
          "platform"
        ],
        "summary": "Get one workspace by key.",
        "operationId": "get_workspace",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "description": "Workspace key, e.g. W-C01",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness probe.",
        "operationId": "live",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness probe.",
        "operationId": "ready",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          },
          "503": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CheckResult": {
        "type": "object",
        "required": [
          "name",
          "ok",
          "critical"
        ],
        "properties": {
          "critical": {
            "type": "boolean",
            "description": "A failing critical check makes the instance unready (503); a failing non-critical check\n(advisory cache, event broker behind the outbox) only reports `degraded`."
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          }
        }
      },
      "CsrfTokenResponse": {
        "type": "object",
        "required": [
          "csrfToken",
          "expiresAt"
        ],
        "properties": {
          "csrfToken": {
            "type": "string",
            "description": "Pre-session CSRF token; echo it as `X-CSRF-Token` on login and MFA verification. The\nsame value is set in the `__Host-sutra_login_csrf` cookie (double submit)."
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ExecutionScope": {
        "type": "object",
        "description": "The validated scope a protected operation executes in. Must be carried across every\nsynchronous, asynchronous, workflow and persistence hand-off.",
        "required": [
          "tenantId"
        ],
        "properties": {
          "institutionId": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/InstitutionId"
              }
            ]
          },
          "tenantId": {
            "$ref": "#/components/schemas/TenantId"
          }
        }
      },
      "FieldViolation": {
        "type": "object",
        "description": "A single field-level validation failure (`validationErrors[]` in problem+json).",
        "required": [
          "field",
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable reason code."
          },
          "field": {
            "type": "string",
            "description": "JSON pointer or dotted path of the offending member."
          },
          "message": {
            "type": "string",
            "description": "Human readable explanation."
          }
        }
      },
      "HealthStatus": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CheckResult"
            }
          },
          "status": {
            "type": "string",
            "description": "`ok`, `degraded` (some check failed; 503 only if a critical one did) or `draining`."
          }
        }
      },
      "Institution": {
        "type": "object",
        "required": [
          "id",
          "tenantId",
          "code",
          "name",
          "timezone",
          "version",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "$ref": "#/components/schemas/InstitutionId"
          },
          "name": {
            "type": "string"
          },
          "tenantId": {
            "$ref": "#/components/schemas/TenantId"
          },
          "timezone": {
            "type": "string",
            "description": "IANA timezone governing business-local dates for this institution."
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "$ref": "#/components/schemas/Version"
          }
        }
      },
      "InstitutionId": {
        "type": "string",
        "format": "uuid",
        "description": "Institution scope, always a descendant of a Tenant."
      },
      "LoginOutcome": {
        "type": "string",
        "enum": [
          "authenticated",
          "mfaRequired"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "loginId",
          "password"
        ],
        "properties": {
          "loginId": {
            "type": "string",
            "description": "Governed login identifier (e-mail in the dev realm).",
            "example": "admin@sutra.dev"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": [
          "outcome",
          "mfaEnrollmentRequired"
        ],
        "properties": {
          "challengeId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Present when `outcome = mfaRequired`."
          },
          "csrfToken": {
            "type": [
              "string",
              "null"
            ],
            "description": "Present when `outcome = authenticated`: the session's synchronizer CSRF token. Send it as\n`X-CSRF-Token` on every POST/PUT/PATCH/DELETE made with the session cookie."
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Present when `outcome = authenticated`: absolute session expiry."
          },
          "mfaEnrollmentRequired": {
            "type": "boolean",
            "description": "`true` when the account must enrol a second factor (`/api/v1/auth/mfa/totp/enrolment`);\nuntil then step-up-protected permissions are refused."
          },
          "mfaLevel": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/MfaLevel",
                "description": "Present when `outcome = authenticated`: assurance of the new session."
              }
            ]
          },
          "mfaMethods": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MfaMethod"
            }
          },
          "outcome": {
            "$ref": "#/components/schemas/LoginOutcome"
          },
          "principal": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Principal",
                "description": "Present when `outcome = authenticated`."
              }
            ]
          }
        }
      },
      "LogoutResponse": {
        "type": "object",
        "required": [
          "endSessionUrl"
        ],
        "properties": {
          "endSessionUrl": {
            "type": "string",
            "description": "Keycloak RP-initiated logout URL; navigate the browser there to end the SSO session."
          }
        }
      },
      "MfaLevel": {
        "type": "string",
        "description": "Authentication assurance of a session (ADR-L5-0038 §3.8).\n\n`Mfa` means the session was established (or stepped up) with a second factor: a TOTP code\nverified by SutraERP in dev mode, or Keycloak-asserted `amr`/`acr` values in Keycloak mode.",
        "enum": [
          "none",
          "mfa"
        ]
      },
      "MfaMethod": {
        "type": "string",
        "description": "MFA method family (WebAuthn preferred for privileged users, TOTP fallback).",
        "enum": [
          "webauthn",
          "totp"
        ]
      },
      "MfaVerifyRequest": {
        "type": "object",
        "required": [
          "challengeId",
          "code"
        ],
        "properties": {
          "challengeId": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "Six-digit TOTP code.",
            "example": "123456"
          }
        }
      },
      "ModuleDescriptor": {
        "type": "object",
        "required": [
          "domain",
          "key",
          "name",
          "schema",
          "batch",
          "status"
        ],
        "properties": {
          "batch": {
            "type": "integer",
            "format": "int32",
            "description": "Delivery batch that implements the module.",
            "minimum": 0
          },
          "domain": {
            "type": "string",
            "description": "Domain letter from the architecture (A–J)."
          },
          "key": {
            "type": "string",
            "description": "Crate / route key, e.g. `student`."
          },
          "name": {
            "type": "string"
          },
          "schema": {
            "type": "string",
            "description": "Owned PostgreSQL schema (ADR-L5-0036 §3.1)."
          },
          "status": {
            "$ref": "#/components/schemas/ModuleStatus"
          }
        }
      },
      "ModuleStatus": {
        "type": "string",
        "enum": [
          "scaffolded",
          "active"
        ]
      },
      "Principal": {
        "type": "object",
        "description": "The authenticated principal (technical identity bound to a SutraERP canonical identity).",
        "required": [
          "subject",
          "displayName",
          "loginId",
          "roles",
          "scope"
        ],
        "properties": {
          "displayName": {
            "type": "string"
          },
          "loginId": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Role"
            }
          },
          "scope": {
            "$ref": "#/components/schemas/ExecutionScope"
          },
          "subject": {
            "type": "string",
            "description": "Stable subject reference (Keycloak `sub` in production)."
          }
        }
      },
      "Problem": {
        "type": "object",
        "description": "RFC 9457 problem document with SutraERP extension members.",
        "required": [
          "type",
          "title",
          "status",
          "errorCode"
        ],
        "properties": {
          "correlationId": {
            "type": [
              "string",
              "null"
            ],
            "description": "SutraERP extension: request correlation id (technical context only)."
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "errorCode": {
            "type": "string",
            "description": "SutraERP extension: stable machine-readable error code."
          },
          "instance": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "URI reference identifying the problem type."
          },
          "validationErrors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldViolation"
            },
            "description": "SutraERP extension: structured field violations."
          }
        }
      },
      "RegisterInstitution": {
        "type": "object",
        "required": [
          "code",
          "name"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Short institution code, unique within the tenant (`A-Z0-9-`, 2–32 chars).",
            "example": "SIT"
          },
          "name": {
            "type": "string",
            "example": "Sutra Institute of Technology"
          },
          "timezone": {
            "type": [
              "string",
              "null"
            ],
            "example": "Asia/Kolkata"
          }
        }
      },
      "RenameInstitution": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "Role": {
        "type": "string",
        "description": "Application role as presented by the web client. Authorization decisions use the\n[`Permission`] map below, never the role name directly.",
        "enum": [
          "administrator",
          "faculty",
          "student"
        ]
      },
      "SessionInfo": {
        "type": "object",
        "required": [
          "principal",
          "expiresAt",
          "idleExpiresAt",
          "csrfToken",
          "mfaLevel",
          "amr",
          "mfaEnrollmentRequired"
        ],
        "properties": {
          "amr": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Authentication methods references (`pwd`, `otp`, …)."
          },
          "csrfToken": {
            "type": "string",
            "description": "Synchronizer CSRF token bound to this session; send as `X-CSRF-Token` on unsafe requests."
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "Absolute expiry (re-authentication required afterwards)."
          },
          "idleExpiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "Expiry if the session stays idle from now on (sliding window)."
          },
          "mfaEnrollmentRequired": {
            "type": "boolean",
            "description": "`true` when the account must enrol a second factor."
          },
          "mfaLevel": {
            "$ref": "#/components/schemas/MfaLevel",
            "description": "Assurance of the session: `mfa` once a second factor was verified."
          },
          "principal": {
            "$ref": "#/components/schemas/Principal"
          }
        }
      },
      "TenantId": {
        "type": "string",
        "format": "uuid",
        "description": "Root protected technical scope."
      },
      "TotpCodeRequest": {
        "type": "object",
        "required": [
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Six-digit TOTP code from the authenticator app.",
            "example": "123456"
          }
        }
      },
      "TotpEnrolmentResponse": {
        "type": "object",
        "required": [
          "otpauthUri",
          "secret",
          "digits",
          "period"
        ],
        "properties": {
          "digits": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "otpauthUri": {
            "type": "string",
            "description": "`otpauth://totp/…` key URI (render as a QR code)."
          },
          "period": {
            "type": "integer",
            "format": "int64"
          },
          "secret": {
            "type": "string",
            "description": "Base32 shared secret for manual entry."
          }
        }
      },
      "Version": {
        "type": "integer",
        "format": "int64"
      },
      "WorkflowEntry": {
        "type": "object",
        "required": [
          "label",
          "roles",
          "scenarios"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Role"
            }
          },
          "scenarios": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "Workspace": {
        "type": "object",
        "required": [
          "key",
          "name",
          "group",
          "roles",
          "workflows"
        ],
        "properties": {
          "group": {
            "type": "string",
            "description": "Navigation group (platform, institution, academics, students, …)."
          },
          "key": {
            "type": "string",
            "description": "Stable workspace key, e.g. `W-C01`."
          },
          "name": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Role"
            }
          },
          "workflows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkflowEntry"
            }
          }
        }
      },
      "WorkspaceList": {
        "type": "object",
        "required": [
          "items",
          "total",
          "workflowTotal"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Workspace"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "workflowTotal": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "securitySchemes": {
      "csrf_token": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token",
        "description": "Session-bound synchronizer token from login or GET /api/v1/auth/session."
      },
      "login_csrf": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token",
        "description": "Pre-session double-submit token from GET /api/v1/auth/csrf (must equal the `__Host-sutra_login_csrf` cookie)."
      },
      "session_cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-sutra_session",
        "description": "Opaque server-side session token (`sutra_session` when Secure cookies are off in dev)."
      }
    }
  },
  "tags": [
    {
      "name": "health",
      "description": "Liveness and readiness probes"
    },
    {
      "name": "auth",
      "description": "D01 authentication boundary (Keycloak-delegated, server-side session)"
    },
    {
      "name": "platform",
      "description": "A Platform: catalog and module registry"
    },
    {
      "name": "institution",
      "description": "B Institution (reference aggregate)"
    }
  ]
}
