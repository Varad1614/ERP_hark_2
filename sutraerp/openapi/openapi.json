{
  "openapi": "3.1.0",
  "info": {
    "title": "SutraERP API",
    "description": "SutraERP education ERP — synchronous REST/JSON API (major version v1).\n\nConventions (ADR-L5-0034): camelCase JSON members; URL major versioning (`/api/v1`); RFC 9457 `application/problem+json` errors with `errorCode`, `correlationId` and `validationErrors` extensions; retry-sensitive commands accept `Idempotency-Key`.\n\nAuthentication (ADR-L5-0038): `POST /api/v1/auth/login` sets an opaque `HttpOnly` session cookie and returns a `csrfToken`; every POST/PUT/PATCH/DELETE made with the cookie must send it as `X-CSRF-Token` (login and MFA verification excepted). Tenant/institution scope is taken from the session (ADR-L5-0004); scope headers cannot select or widen it. Missing session: 401; CSRF failure or missing permission: 403 (`application/problem+json`).",
    "license": {
      "name": "UNLICENSED",
      "identifier": "UNLICENSED"
    },
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Authenticate with login id + password.",
        "description": "Delegates to the configured credential authority (Keycloak in production, dev stub in Batch 0)\nand, on success, sets an opaque `HttpOnly; Secure; SameSite=Strict` session cookie and returns\nthe session's CSRF token. Privileged principals may receive `mfaRequired` instead and must\ncall `/api/v1/auth/mfa/verify`. Exempt from the CSRF check (no session exists yet); any\npresented session is revoked and replaced (fixation defence).",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Authenticated or MFA required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials (generic)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "End the current session (idempotent).",
        "description": "With a live session the request must carry `X-CSRF-Token` (prevents forced sign-out).",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Signed out"
          },
          "403": {
            "description": "CSRF token missing or invalid",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "csrf_token": [],
            "session_cookie": []
          }
        ]
      }
    },
    "/api/v1/auth/mfa/verify": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Complete an MFA challenge issued by `login`.",
        "operationId": "verify_mfa",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MfaVerifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Current session: principal, expiries and the session's CSRF token.",
        "description": "Counts as activity (slides the idle window).",
        "operationId": "session",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            }
          },
          "401": {
            "description": "",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "session_cookie": []
          }
        ]
      }
    },
    "/api/v1/institution/institutions": {
      "post": {
        "tags": [
          "institution"
        ],
        "summary": "Register an institution (reference aggregate) in the caller's session tenant.",
        "description": "Requires the `institution.register` permission (administrators).",
        "operationId": "register",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Required. Retry-safe key (1-255 visible ASCII).",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "description": "Required. Session CSRF token from login or GET /api/v1/auth/session.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterInstitution"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "Current version"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Institution"
                }
              }
            }
          },
          "400": {
            "description": "",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "No live session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "CSRF failure or missing `institution.register` permission",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "csrf_token": [],
            "session_cookie": []
          }
        ]
      }
    },
    "/api/v1/institution/institutions/{id}": {
      "get": {
        "tags": [
          "institution"
        ],
        "summary": "Get an institution of the caller's session tenant (`institution.read`).",
        "description": "Institutions of other tenants are indistinguishable from missing ones (404).",
        "operationId": "get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Institution"
                }
              }
            }
          },
          "401": {
            "description": "No live session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Missing `institution.read` permission",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "session_cookie": []
          }
        ]
      },
      "patch": {
        "tags": [
          "institution"
        ],
        "summary": "Rename an institution of the caller's session tenant (optimistic concurrency via `If-Match`).",
        "description": "Requires the `institution.rename` permission (administrators).",
        "operationId": "rename",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "description": "ETag of the version being modified",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "description": "Required. Session CSRF token from login or GET /api/v1/auth/session.",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RenameInstitution"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Institution"
                }
              }
            }
          },
          "401": {
            "description": "No live session",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "CSRF failure or missing `institution.rename` permission",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "412": {
            "description": "",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "428": {
            "description": "",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "csrf_token": [],
            "session_cookie": []
          }
        ]
      }
    },
    "/api/v1/platform/modules": {
      "get": {
        "tags": [
          "platform"
        ],
        "summary": "Modules composed into this modular-monolith build.",
        "operationId": "list_modules",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ModuleDescriptor"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/platform/workspaces": {
      "get": {
        "tags": [
          "platform"
        ],
        "summary": "List workspaces (navigation catalog).",
        "operationId": "list_workspaces",
        "parameters": [
          {
            "name": "role",
            "in": "query",
            "description": "Only workspaces visible to this role.",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Role"
            }
          },
          {
            "name": "group",
            "in": "query",
            "description": "Navigation group filter (e.g. `students`, `finance`).",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceList"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/platform/workspaces/{key}": {
      "get": {
        "tags": [
          "platform"
        ],
        "summary": "Get one workspace by key.",
        "operationId": "get_workspace",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "description": "Workspace key, e.g. W-C01",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness probe.",
        "operationId": "live",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness probe.",
        "operationId": "ready",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          },
          "503": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CheckResult": {
        "type": "object",
        "required": [
          "name",
          "ok"
        ],
        "properties": {
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          }
        }
      },
      "ExecutionScope": {
        "type": "object",
        "description": "The validated scope a protected operation executes in. Must be carried across every\nsynchronous, asynchronous, workflow and persistence hand-off.",
        "required": [
          "tenantId"
        ],
        "properties": {
          "institutionId": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/InstitutionId"
              }
            ]
          },
          "tenantId": {
            "$ref": "#/components/schemas/TenantId"
          }
        }
      },
      "FieldViolation": {
        "type": "object",
        "description": "A single field-level validation failure (`validationErrors[]` in problem+json).",
        "required": [
          "field",
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable reason code."
          },
          "field": {
            "type": "string",
            "description": "JSON pointer or dotted path of the offending member."
          },
          "message": {
            "type": "string",
            "description": "Human readable explanation."
          }
        }
      },
      "HealthStatus": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CheckResult"
            }
          },
          "status": {
            "type": "string",
            "description": "`ok`, `degraded` or `draining`."
          }
        }
      },
      "Institution": {
        "type": "object",
        "required": [
          "id",
          "tenantId",
          "code",
          "name",
          "timezone",
          "version",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "$ref": "#/components/schemas/InstitutionId"
          },
          "name": {
            "type": "string"
          },
          "tenantId": {
            "$ref": "#/components/schemas/TenantId"
          },
          "timezone": {
            "type": "string",
            "description": "IANA timezone governing business-local dates for this institution."
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "version": {
            "$ref": "#/components/schemas/Version"
          }
        }
      },
      "InstitutionId": {
        "type": "string",
        "format": "uuid",
        "description": "Institution scope, always a descendant of a Tenant."
      },
      "LoginOutcome": {
        "type": "string",
        "enum": [
          "authenticated",
          "mfaRequired"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "loginId",
          "password"
        ],
        "properties": {
          "loginId": {
            "type": "string",
            "description": "Governed login identifier (e-mail in the dev realm).",
            "example": "admin@sutra.dev"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": [
          "outcome"
        ],
        "properties": {
          "challengeId": {
            "type": [
              "string",
              "null"
            ],
            "description": "Present when `outcome = mfaRequired`."
          },
          "csrfToken": {
            "type": [
              "string",
              "null"
            ],
            "description": "Present when `outcome = authenticated`: the session's synchronizer CSRF token. Send it as\n`X-CSRF-Token` on every POST/PUT/PATCH/DELETE made with the session cookie."
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Present when `outcome = authenticated`: absolute session expiry."
          },
          "mfaMethods": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MfaMethod"
            }
          },
          "outcome": {
            "$ref": "#/components/schemas/LoginOutcome"
          },
          "principal": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Principal",
                "description": "Present when `outcome = authenticated`."
              }
            ]
          }
        }
      },
      "MfaMethod": {
        "type": "string",
        "description": "MFA method family (WebAuthn preferred for privileged users, TOTP fallback).",
        "enum": [
          "webauthn",
          "totp"
        ]
      },
      "MfaVerifyRequest": {
        "type": "object",
        "required": [
          "challengeId",
          "code"
        ],
        "properties": {
          "challengeId": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "ModuleDescriptor": {
        "type": "object",
        "required": [
          "domain",
          "key",
          "name",
          "schema",
          "batch",
          "status"
        ],
        "properties": {
          "batch": {
            "type": "integer",
            "format": "int32",
            "description": "Delivery batch that implements the module.",
            "minimum": 0
          },
          "domain": {
            "type": "string",
            "description": "Domain letter from the architecture (A–J)."
          },
          "key": {
            "type": "string",
            "description": "Crate / route key, e.g. `student`."
          },
          "name": {
            "type": "string"
          },
          "schema": {
            "type": "string",
            "description": "Owned PostgreSQL schema (ADR-L5-0036 §3.1)."
          },
          "status": {
            "$ref": "#/components/schemas/ModuleStatus"
          }
        }
      },
      "ModuleStatus": {
        "type": "string",
        "enum": [
          "scaffolded",
          "active"
        ]
      },
      "Principal": {
        "type": "object",
        "description": "The authenticated principal (technical identity bound to a SutraERP canonical identity).",
        "required": [
          "subject",
          "displayName",
          "loginId",
          "roles",
          "scope"
        ],
        "properties": {
          "displayName": {
            "type": "string"
          },
          "loginId": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Role"
            }
          },
          "scope": {
            "$ref": "#/components/schemas/ExecutionScope"
          },
          "subject": {
            "type": "string",
            "description": "Stable subject reference (Keycloak `sub` in production)."
          }
        }
      },
      "Problem": {
        "type": "object",
        "description": "RFC 9457 problem document with SutraERP extension members.",
        "required": [
          "type",
          "title",
          "status",
          "errorCode"
        ],
        "properties": {
          "correlationId": {
            "type": [
              "string",
              "null"
            ],
            "description": "SutraERP extension: request correlation id (technical context only)."
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "errorCode": {
            "type": "string",
            "description": "SutraERP extension: stable machine-readable error code."
          },
          "instance": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "description": "URI reference identifying the problem type."
          },
          "validationErrors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldViolation"
            },
            "description": "SutraERP extension: structured field violations."
          }
        }
      },
      "RegisterInstitution": {
        "type": "object",
        "required": [
          "code",
          "name"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Short institution code, unique within the tenant (`A-Z0-9-`, 2–32 chars).",
            "example": "SIT"
          },
          "name": {
            "type": "string",
            "example": "Sutra Institute of Technology"
          },
          "timezone": {
            "type": [
              "string",
              "null"
            ],
            "example": "Asia/Kolkata"
          }
        }
      },
      "RenameInstitution": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          }
        }
      },
      "Role": {
        "type": "string",
        "description": "Application role as presented by the web client. Authorization decisions use the\n[`Permission`] map below, never the role name directly.",
        "enum": [
          "administrator",
          "faculty",
          "student"
        ]
      },
      "SessionInfo": {
        "type": "object",
        "required": [
          "principal",
          "expiresAt",
          "idleExpiresAt",
          "csrfToken"
        ],
        "properties": {
          "csrfToken": {
            "type": "string",
            "description": "Synchronizer CSRF token bound to this session; send as `X-CSRF-Token` on unsafe requests."
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "Absolute expiry (re-authentication required afterwards)."
          },
          "idleExpiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "Expiry if the session stays idle from now on (sliding window)."
          },
          "principal": {
            "$ref": "#/components/schemas/Principal"
          }
        }
      },
      "TenantId": {
        "type": "string",
        "format": "uuid",
        "description": "Root protected technical scope."
      },
      "Version": {
        "type": "integer",
        "format": "int64"
      },
      "WorkflowEntry": {
        "type": "object",
        "required": [
          "label",
          "roles",
          "scenarios"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Role"
            }
          },
          "scenarios": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "Workspace": {
        "type": "object",
        "required": [
          "key",
          "name",
          "group",
          "roles",
          "workflows"
        ],
        "properties": {
          "group": {
            "type": "string",
            "description": "Navigation group (platform, institution, academics, students, …)."
          },
          "key": {
            "type": "string",
            "description": "Stable workspace key, e.g. `W-C01`."
          },
          "name": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Role"
            }
          },
          "workflows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkflowEntry"
            }
          }
        }
      },
      "WorkspaceList": {
        "type": "object",
        "required": [
          "items",
          "total",
          "workflowTotal"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Workspace"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "workflowTotal": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "securitySchemes": {
      "csrf_token": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token",
        "description": "Session-bound synchronizer token from login or GET /api/v1/auth/session."
      },
      "session_cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-sutra_session",
        "description": "Opaque server-side session token (`sutra_session` when Secure cookies are off in dev)."
      }
    }
  },
  "tags": [
    {
      "name": "health",
      "description": "Liveness and readiness probes"
    },
    {
      "name": "auth",
      "description": "D01 authentication boundary (Keycloak-delegated, server-side session)"
    },
    {
      "name": "platform",
      "description": "A Platform: catalog and module registry"
    },
    {
      "name": "institution",
      "description": "B Institution (reference aggregate)"
    }
  ]
}
