# oidc = sutra-api in Keycloak mode; "Sign in" redirects to single sign-on (default for builds)
# api  = POST /api/v1/auth/login against sutra-api (dev authenticator): login id + password form
# mock = role personas resolved in the browser (no API needed; `react-router dev` default)
VITE_AUTH_MODE=mock
# true = offer the seeded dev personas on the sign-in page (password is always typed, never
# embedded) and the role switcher in the account menu. Never set for a public build.
# VITE_DEV_PERSONAS=true
