# ---------------------------------------------------------------------------
# SutraERP API (sutra-api) — copy to .env for local development
# ---------------------------------------------------------------------------
# development | test | production
SUTRA_ENV=development
SUTRA_HTTP_ADDR=0.0.0.0:8080
# pretty | json (json is the production default)
SUTRA_LOG_FORMAT=pretty
RUST_LOG=info,sutra=debug,tower_http=info,sqlx=warn

# PostgreSQL 18 (docker-compose service `postgres`)
DATABASE_URL=postgres://sutra:sutra@localhost:5432/sutra
SUTRA_DB_MAX_CONNECTIONS=10
SUTRA_DB_ACQUIRE_TIMEOUT_SECS=5

SUTRA_REQUEST_TIMEOUT_SECS=30
SUTRA_SHUTDOWN_GRACE_SECS=20

# Part 1 · Stage 3 — transport hardening (docs/security/config.md). Every value in this file is
# a DEVELOPMENT value: with SUTRA_ENV=production the API refuses to start on any of them (dev
# passwords / secrets, http URLs, no sslmode, SUTRA_DEV_*, mock payments, …).
# HSTS max-age (production default 31536000, minimum 15552000; 0 = off, the dev default)
# SUTRA_HSTS_MAX_AGE_SECS=0
# Largest accepted request body (bytes, 1 KiB ..= 64 MiB)
# SUTRA_MAX_BODY_BYTES=2097152
# Per-client rate limiting of the unauthenticated API (production default on, refused off):
# SUTRA_RATE_LIMIT=false
# SUTRA_RATE_LIMIT_CREDENTIALS_PER_MIN=30   # login / MFA verify / step-up
# SUTRA_RATE_LIMIT_CREDENTIALS_BURST=10
# SUTRA_RATE_LIMIT_AUTH_PER_MIN=300         # csrf, OIDC start / callback
# SUTRA_RATE_LIMIT_AUTH_BURST=100
# SUTRA_RATE_LIMIT_PUBLIC_PER_MIN=600       # any other request without a session
# SUTRA_RATE_LIMIT_PUBLIC_BURST=200
# SUTRA_RATE_LIMIT_SESSION_PER_MIN=600      # authenticated requests per session (audit M-4)
# SUTRA_RATE_LIMIT_SESSION_BURST=120
# SUTRA_RATE_LIMIT_SESSION_IP_PER_MIN=3000  # authenticated requests per client address
# SUTRA_RATE_LIMIT_SESSION_IP_BURST=600
# Reverse proxies in front of the API that append X-Forwarded-For (production default 1)
# SUTRA_TRUSTED_PROXY_HOPS=0
# Serve GET /api/openapi.json / dependency error texts in /health/ready (both refused in production)
# SUTRA_API_DOCS=true
# SUTRA_HEALTH_DETAIL=true

# Auth (ADR-L5-0024 / ADR-L5-0038). `dev` is refused when SUTRA_ENV=production.
# dev      = seeded personas + shared password, SutraERP TOTP MFA (enrol / verify / step-up)
# keycloak = OIDC Authorization Code + PKCE via GET /api/v1/auth/oidc/start|callback (no ROPC);
#            MFA (TOTP / WebAuthn) is done by Keycloak and read from the amr/acr claims.
# (SUTRA_AUTH_PROVIDER is accepted as a legacy alias.)
SUTRA_AUTH_MODE=dev
# Shared password of the dev personas. REQUIRED for SUTRA_AUTH_MODE=dev and there is no default
# (audit D1/C1): the API refuses to start until you set your own value of at least 12 characters
# that is not a published dev value (`sutra`, `change-me`, …). Alias: SUTRA_DEV_PASSWORD.
# SUTRA_DEV_AUTH_PASSWORD=
# true = administrators must use TOTP (enrol on first sign-in, then a code at every sign-in)
SUTRA_DEV_MFA=false
SUTRA_DEV_TENANT_ID=0192f5a0-7c3e-7000-8000-000000000001
# Empty = tenant-wide dev sessions; an institution id pins every dev session to it (DEF-C-010).
SUTRA_DEV_INSTITUTION_ID=

# Step-up: admin-sensitive permissions (institution.register) need an MFA-verified session.
# Default: on in production / keycloak mode / when SUTRA_DEV_MFA=true; forced on in production.
# SUTRA_MFA_STEP_UP=true
# AES-256-GCM key for TOTP secrets at rest (64 hex chars). Built-in dev key if unset; the dev
# key is refused in production.
# SUTRA_MFA_ENCRYPTION_KEY=
SUTRA_MFA_ISSUER=SutraERP

# OIDC relying party (SUTRA_AUTH_MODE=keycloak). Issuer defaults to SUTRA_KEYCLOAK_URL/realms/SUTRA_KEYCLOAK_REALM.
SUTRA_KEYCLOAK_URL=http://localhost:8180
SUTRA_KEYCLOAK_REALM=sutra
# SUTRA_OIDC_ISSUER=http://localhost:8180/realms/sutra
# Server-to-server base when the API reaches Keycloak on another host name (compose: http://keycloak:8180/realms/sutra)
# SUTRA_OIDC_BACKCHANNEL_URL=
SUTRA_OIDC_CLIENT_ID=sutra-web
# Required in production.
SUTRA_OIDC_CLIENT_SECRET=dev-only-change-me
SUTRA_OIDC_REDIRECT_URI=http://localhost:5173/api/v1/auth/oidc/callback
SUTRA_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/sign-in
SUTRA_OIDC_TENANT_CLAIM=tenant_id
SUTRA_OIDC_INSTITUTION_CLAIM=institution_id
# acr values that count as MFA, and acr_values requested on step-up
SUTRA_OIDC_MFA_ACR=2,mfa
SUTRA_OIDC_STEP_UP_ACR=mfa

# Login CSRF: HMAC key of the signed double-submit token from GET /api/v1/auth/csrf (64 hex
# chars). Unset = random per process (fine for one dev instance); required in production.
# SUTRA_CSRF_KEY=
SUTRA_LOGIN_CSRF_TTL_SECS=1800
# Extra origins allowed to send unsafe requests (comma separated). The API's own Host is always
# allowed; cross-site (Sec-Fetch-Site: cross-site) or foreign-Origin POST/PUT/PATCH/DELETE → 403.
# SUTRA_ALLOWED_ORIGINS=https://erp.example.edu

# Session cookie: Secure is on by default (browsers accept Secure cookies on http://localhost).
SUTRA_SESSION_COOKIE_SECURE=true
# Absolute session lifetime (cookie Max-Age) and idle timeout; idle must be <= absolute.
SUTRA_SESSION_TTL_SECS=28800
SUTRA_SESSION_IDLE_SECS=1800
# last_seen_at is written at most once per this many seconds per session (must be < idle).
SUTRA_SESSION_TOUCH_SECS=60

# Stores: postgres | memory (memory = no database needed; refused in production)
SUTRA_SESSION_STORE=postgres
SUTRA_IDEMPOTENCY_STORE=postgres
SUTRA_AUDIT_SINK=postgres

# ---- Batch 1C: outbox relay → NATS JetStream (ADR-L5-0022) ----
# off | nats. Default: off in development/test, nats in production. `off` is refused in production
# unless SUTRA_OUTBOX_RELAY_ALLOW_OFF=true (e.g. API replicas while a dedicated deployment relays).
SUTRA_OUTBOX_RELAY=off
# SUTRA_OUTBOX_RELAY_ALLOW_OFF=false
SUTRA_NATS_URL=nats://localhost:4222
# Stream capturing <prefix>.> ; created at startup if missing (file storage, limits retention).
SUTRA_NATS_STREAM=SUTRA_EVENTS
SUTRA_NATS_SUBJECT_PREFIX=sutra
# Broker de-duplication window for Nats-Msg-Id (must exceed SUTRA_OUTBOX_LEASE_SECS)
SUTRA_NATS_DUPLICATE_WINDOW_SECS=120
SUTRA_NATS_STREAM_MAX_AGE_SECS=604800
SUTRA_NATS_STREAM_REPLICAS=1
SUTRA_OUTBOX_BATCH_SIZE=100
SUTRA_OUTBOX_POLL_MS=500
# Claimed rows are reserved this long (>= 2 x publish timeout); a crashed relay's rows come back after it.
SUTRA_OUTBOX_LEASE_SECS=30
SUTRA_OUTBOX_PUBLISH_TIMEOUT_SECS=5
# Retries: exponential backoff with jitter between base and max, dead-letter after max attempts.
SUTRA_OUTBOX_MAX_ATTEMPTS=12
SUTRA_OUTBOX_BACKOFF_BASE_MS=1000
SUTRA_OUTBOX_BACKOFF_MAX_SECS=300

# ---- Batch 1C: advisory cache (ADR-L5-0037) ----
# off | memory | valkey. Default: memory in development/test, off in production (a process-local
# cache is not shared between replicas). Failures degrade to cache misses.
SUTRA_CACHE=memory
# redis://[user:pass@]host:6379[/db] or rediss:// (TLS via rustls)
SUTRA_VALKEY_URL=redis://localhost:6379
# Key environment segment (defaults to the SUTRA_ENV name)
# SUTRA_CACHE_NAMESPACE=development
SUTRA_CACHE_TTL_SECS=60
SUTRA_CACHE_TIMEOUT_MS=250
SUTRA_CACHE_MEMORY_MAX_ENTRIES=10000

# ---- Batch 1C: sweepers (one replica per job via PostgreSQL advisory locks) ----
# Default: on, except SUTRA_ENV=test. A zero interval disables one job.
SUTRA_SWEEPERS=true
SUTRA_SWEEP_BATCH_LIMIT=5000
SUTRA_SWEEP_IDEMPOTENCY_SECS=300
SUTRA_SWEEP_OUTBOX_SECS=3600
# Published outbox rows are kept this long (dead-lettered rows are never purged automatically)
SUTRA_OUTBOX_RETENTION_SECS=604800
SUTRA_SWEEP_SESSION_SECS=900
# Expired/revoked/idle sessions are kept this long before deletion
SUTRA_SESSION_PURGE_GRACE_SECS=86400
SUTRA_SWEEP_PREAUTH_SECS=300
SUTRA_PREAUTH_PURGE_GRACE_SECS=300

# ---- Batch 1D: database roles (ADR-L5-0005 / ADR-L5-0036 §3.1) ----
# `sutra-api migrate` connects as the schema OWNER: SUTRA_MIGRATION_DATABASE_URL (falls back to
# DATABASE_URL). With SUTRA_DB_RUNTIME_USER/_PASSWORD set it also creates/updates that LOGIN role
# as a member of `sutra_app` (DML on module schemas only; owns nothing, no DDL). The API then
# serves with DATABASE_URL pointing at the runtime role, e.g.
#   SUTRA_MIGRATION_DATABASE_URL=postgres://sutra:sutra@localhost:5432/sutra
#   SUTRA_DB_RUNTIME_USER=sutra_api
#   SUTRA_DB_RUNTIME_PASSWORD=sutra-api-dev-only
#   DATABASE_URL=postgres://sutra_api:sutra-api-dev-only@localhost:5432/sutra   (for `make api`)
# Unset = migrate and serve as the DATABASE_URL role (simplest local setup).
# SUTRA_MIGRATION_DATABASE_URL=
# SUTRA_DB_RUNTIME_USER=
# SUTRA_DB_RUNTIME_PASSWORD=

# ---- Batch 1D: notifications, notices, to-dos ----
# Browser-facing base URL used for links in notification e-mails.
SUTRA_PUBLIC_URL=http://localhost:5173
# E-mail channel: off | smtp (Mailpit in development: SMTP localhost:1025, UI http://localhost:8025).
SUTRA_NOTIFY_EMAIL=off
SUTRA_SMTP_HOST=localhost
SUTRA_SMTP_PORT=1025
# none | starttls | tls
SUTRA_SMTP_TLS=none
# SUTRA_SMTP_USERNAME=
# SUTRA_SMTP_PASSWORD=
SUTRA_SMTP_TIMEOUT_SECS=10
SUTRA_MAIL_FROM="SutraERP <no-reply@sutra.dev>"
# Delivery job tick and attempts before an e-mail is marked failed (exponential backoff).
SUTRA_NOTIFY_DELIVERY_MS=5000
SUTRA_NOTIFY_MAX_ATTEMPTS=5
# Domain-event consumer that turns outbox events into notifications / to-dos (default: on, off in test).
SUTRA_INBOX_CONSUMER=true
SUTRA_INBOX_POLL_MS=2000
# How far back a fresh consumer starts reading events, and events per pass.
SUTRA_INBOX_LOOKBACK_SECS=604800
SUTRA_INBOX_BATCH_SIZE=200
# Retention sweeper: read notifications, expired/archived notices, closed to-dos.
SUTRA_SWEEP_INBOX_SECS=3600
SUTRA_NOTIFICATION_RETENTION_SECS=7776000
SUTRA_NOTICE_RETENTION_SECS=15552000
SUTRA_TODO_RETENTION_SECS=7776000

# ---- Batch 1D: dev-mode WebAuthn (passkeys as second factor; Keycloak handles it in keycloak mode) ----
# RP id = registrable domain of the browser origin; origins = exact browser origins allowed.
SUTRA_WEBAUTHN_RP_ID=localhost
SUTRA_WEBAUTHN_RP_NAME=SutraERP
SUTRA_WEBAUTHN_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Batch 1D: Keycloak back-channel logout ----
# Registered on the `sutra-web` client in deploy/keycloak/realm-sutra-dev.json (session required):
#   http://api:8080/api/v1/auth/oidc/backchannel-logout   (compose network)
# For an API on the host (`make api`), change it in the Keycloak admin console to
#   http://host.docker.internal:8080/api/v1/auth/oidc/backchannel-logout

# ---- 3D expense claims: receipt OCR (tools/ocr-sidecar, PaddleOCR; optional) ----
# Base URL of the self-hosted OCR sidecar (`docker compose --profile ocr`). Unset = receipt reading
# off: uploads still work, nothing is pre-filled. OCR only pre-fills; the claimant confirms.
# SUTRA_OCR_URL=http://localhost:8866
# Per-receipt OCR request timeout in seconds (1..=300, default 30).
# SUTRA_OCR_TIMEOUT_SECS=30

# OpenTelemetry (exporter wiring lands in Batch 9)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ---- Part 2 · S4-docs: document storage (student admission / record files) ----
# S3-compatible object storage (apps/api/src/config_docs.rs; docs/readiness/part2/s4-docs.md).
# disabled = the file endpoints answer 503 (dev / test only; refused in production).
SUTRA_DOCUMENT_STORAGE=s3
# Compose MinIO (`docker compose up -d minio`, built from source, see below). Development values:
# production refuses http endpoints, SUTRA_S3_SSE=none and these secrets.
SUTRA_S3_ENDPOINT=http://localhost:9000
# Browser-facing endpoint used only in presigned links (defaults to SUTRA_S3_ENDPOINT)
# SUTRA_S3_PUBLIC_ENDPOINT=https://files.college.example.edu
SUTRA_S3_REGION=us-east-1
SUTRA_S3_BUCKET=sutraerp-documents
SUTRA_S3_ACCESS_KEY_ID=sutra
SUTRA_S3_SECRET_ACCESS_KEY=sutra-minio-dev-only
# true = path-style URLs (MinIO, SeaweedFS, Garage, Ceph RGW); false = virtual-hosted (AWS S3)
SUTRA_S3_PATH_STYLE=true
# none | AES256 | aws:kms (production default AES256; none is refused in production)
# SUTRA_S3_SSE=AES256
# SUTRA_S3_SSE_KMS_KEY_ID=
# Create the bucket when missing (development / CI only; create it yourself in production)
SUTRA_S3_CREATE_BUCKET=true
# SUTRA_S3_TIMEOUT_MS=15000
# Largest file (1 KiB ..= 64 MiB; also the upload routes' body limit and nginx client_max_body_size)
# SUTRA_DOCS_MAX_BYTES=10485760
# Minimum retention from upload (days; 2920 = 8 years)
# SUTRA_DOCS_RETENTION_DAYS=2920
# Presigned download links, 1 ..= 300 s (0 = off: downloads stream through the API)
# SUTRA_DOCS_PRESIGN_TTL_SECS=0
# SUTRA_DOCS_SWEEP_SECS=3600
#
# How a college runs the storage (SutraERP never uses third-party mirror images):
#  * Managed: AWS S3 (or another provider's S3 API): SUTRA_S3_ENDPOINT=https://s3.<region>.amazonaws.com,
#    SUTRA_S3_PATH_STYLE=false, SUTRA_S3_SSE=AES256 or aws:kms, an access key limited to the one
#    bucket (s3:ListBucket, s3:GetObject, s3:PutObject, s3:DeleteObject); block public access.
#  * Self-hosted MinIO: upstream no longer publishes binaries or images, so build the pinned
#    release from its archived source with Go >= 1.24:
#      MINIO_TAG=RELEASE.2025-10-15T17-29-55Z OUT=/usr/local/bin/minio bash deploy/minio/build-from-source.sh
#    (or `docker build -f deploy/docker/minio.Dockerfile .`), run it behind TLS (MinIO's certs
#    dir or the reverse proxy) with a long random root secret from OpenBao, on a backed-up disk;
#    create the bucket and a dedicated access key for the API.
#  * Alternatives with an S3 API: SeaweedFS (Apache-2.0, `weed server -s3`) or Garage (AGPL-3.0,
#    built for small self-hosted clusters); both work with SUTRA_S3_PATH_STYLE=true.
# In every case the bucket must be private: the API refuses a bucket that answers anonymous reads.

# Part 2 · S5-capacity: services signed by the institution's OWN CA (on-premises MinIO, Keycloak,
# Flowable, OpenSearch behind TLS). PEM bundle trusted IN ADDITION to the public roots by those
# clients (never by the payment gateway); a missing / non-PEM file stops the start-up.
# This is the documented setting. SSL_CERT_FILE (S5-deploy: reqwest rustls-tls-native-roots) is
# still honoured too; the on-prem installer sets both to the same bundle (tls/trust.pem).
# SUTRA_TLS_CA_FILE=/etc/sutraerp/college-ca.pem

# ---------------------------------------------------------------------------
# Web (apps/web) — Vite reads VITE_* at build time
# ---------------------------------------------------------------------------
# oidc (default for builds: API in Keycloak mode, "Sign in" → SSO) | api (dev authenticator:
# login id + password form) | mock (in-browser personas, UI work only). `react-router dev`
# without VITE_AUTH_MODE uses mock.
VITE_AUTH_MODE=mock
# true = the sign-in page offers the seeded dev personas (login id prefilled, password still
# typed) and the account menu offers the role switcher. Never set for a public build.
# VITE_DEV_PERSONAS=true
# SUTRA_API_URL=http://localhost:8080 # dev-server proxy target
